# Yarenler ortam değişkenleri
# Bu dosya yalnız değişken adlarını ve açıklamalarını içerir. Gerçek değerleri
# .env dosyasına yazın (depoya girmez). Sırlar sohbete, loga ve rapora yazılmaz.
# Anahtarlar mümkün olduğunda dosya yolundan okunur (*_FILE değişkenleri).

# --- Genel ---
# Çalışma ortamı: development, staging ya da production
NODE_ENV=
# Sitenin kök adresi (ör. yerelde http://localhost:3000)
PUBLIC_BASE_URL=

# --- Veritabanı (PostgreSQL + pgvector) ---
# Uygulamanın kısıtlı okuma rolü (yarenler_web). dbmate ile elle göç çalıştırırken yönetici adresi verilir.
DATABASE_URL=
# Kimlik ve yazma işlemleri için kısıtlı rol (yarenler_auth)
AUTH_DATABASE_URL=
# Açılış göçleri için tablo sahibi rolün adresi (DDL yetkili). Yalnız göç adımında kullanılır,
# web sunucusu sürecine aktarılmaz. Boşsa açılış göçleri loglanıp atlanır.
MIGRATION_DATABASE_URL=

# --- Kimlik ve oturum ---
# Oturum çerezlerini ve belirteçleri imzalamak için gizli anahtarın dosya yolu
SESSION_SECRET_FILE=

# --- ORCID ile giriş (ADR 0004, yalnız ORCID) ---
# ORCID Public API istemci kimliği (gizli değildir ama burada boş bırakılır)
ORCID_CLIENT_ID=
# ORCID istemci sırrının dosya yolu
ORCID_CLIENT_SECRET_FILE=
# ORCID OAuth geri dönüş adresi (ör. PUBLIC_BASE_URL + /api/v1/auth/orcid/callback)
ORCID_REDIRECT_URI=
# ORCID ortamı: production ya da sandbox
ORCID_ENV=

# --- E-posta (Resend, AB bölgesi) ---
# Resend API anahtarının dosya yolu
RESEND_API_KEY_FILE=
# File path is preferred; runtime-only value is supported. Never mark as build-time.
RESEND_API_KEY=
# Random HMAC secret for daily upload IP limits (runtime only)
UPLOAD_RATE_SECRET=
# Gönderici adresi
EMAIL_FROM=

# --- Push bildirimleri (APNs) ---
APNS_KEY_ID=
APNS_TEAM_ID=
# APNs .p8 anahtar dosyasının yolu
APNS_KEY_FILE=
APNS_TOPIC=

# --- Gömme servisi (TEI) ---
EMBED_SERVICE_URL=

# --- Yapay zekâ (en az kullanım; alan havuzunda karşılık yoksa ve duyuru güçlendirmede) ---
LLM_PROVIDER=
# LLM API anahtarının dosya yolu
LLM_API_KEY_FILE=
# Çalıştırma başına maliyet tavanı (USD)
LLM_BUDGET_USD=
# Aylık toplam maliyet tavanı (USD), ai_call_log üzerinden denetlenir
LLM_MONTHLY_BUDGET_USD=
# OpenRouter anahtarı (duyuru güçlendirme ve yeni alan denetimi, Claude Haiku 5.5). Dosya yolu önceliklidir;
# yoksa OPENROUTER_API_KEY çalışma zamanı değişkeni okunur. İkisi de yoksa yeni alanlar yapay zekâsız,
# yalnız yerel normalizasyonla "denetlenmedi" olarak eklenir.
OPENROUTER_API_KEY_FILE=
OPENROUTER_API_KEY=
# yarenler-01 anlamsal servisi (infra/semantic), ör. http://yarenler-semantic:8000. Boşsa anlamsal yakın alan yok.
SEMANTIC_URL=

# --- Veri hattı ---
# OpenAlex API anahtarının dosya yolu (anahtarın kendisi buraya yazılmaz)
OPENALEX_API_KEY_FILE=
# Crossref "polite pool" ve OpenAlex için iletişim e-postası
CONTACT_EMAIL=
# Tarayıcı kullanıcı ajanı (plan 4, Sözleşme)
CRAWLER_USER_AGENT=
# 1 yapılırsa tüm tarama durur (plan 4)
YARENLER_TARAMA_DURDUR=
# Ham dosya ve rapor klasörü (depoya girmez)
YARENLER_DATA_DIR=

# --- Nesne deposu (S3 uyumlu, ham dosyalar) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID_FILE=
S3_SECRET_ACCESS_KEY_FILE=

# --- Hata izleme (isteğe bağlı, kendi barındırılan GlitchTip ya da Sentry uyumlu) ---
# Proje DSN'i, ör. https://<anahtar>@glitchtip.alan-adi/<proje-no>. Boşsa hata bildirimi kapalıdır.
SENTRY_DSN=
# Ortam adı (varsayılan production)
SENTRY_ENVIRONMENT=
